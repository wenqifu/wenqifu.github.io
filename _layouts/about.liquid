---
layout: default
---
<div class="post about-page">
  <section class="profile-hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">Machine learning · Research</p>
      <h1 id="intro-title">Qifu <span>(Danny)</span> Wen<span class="name-dot">.</span></h1>
      <p class="hero-role">{{ page.subtitle }}</p>
      <div class="hero-bio">{{ content }}</div>
      <div class="hero-links">
        <a class="primary-link" href="{{ '/cv/' | relative_url }}">View CV <span aria-hidden="true">↗</span></a>
        <a href="mailto:qfwen@bu.edu">Email</a>
        <a href="https://scholar.google.com/citations?user=-YHHQvkAAAAJ">Scholar</a>
        <a href="https://github.com/wenqifu">GitHub</a>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Qifu Wen" width="320" height="380" loading="eager">
      <figcaption>Shanghai, China</figcaption>
    </figure>
  </section>
  <section id="research" class="selected-work" aria-labelledby="selected-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A few things I've worked on</p>
        <h2 id="selected-title">Selected publications</h2>
      </div>
      <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
    </div>
    {% assign featured = site.data.featured_work | where: 'featured', true %}
    {% for work in featured -%}
      {%- include work_card.liquid work=work -%}
    {%- endfor %}
    <div class="research-bottom">
      <p>More work in robotics, representation learning, and statistics.</p>
      <a class="text-link" href="{{ '/projects/' | relative_url }}">Explore all projects <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="home-note" aria-labelledby="beyond-title">
    <p class="eyebrow" id="beyond-title">Beyond research</p>
    <p>I enjoy basketball, hiking, and RimWorld. Always happy to talk about research or collaboration.</p>
    <a class="text-link" href="mailto:qfwen@bu.edu">qfwen@bu.edu <span aria-hidden="true">↗</span></a>
  </section>
</div>
<script>
  // Preserve previously shared homepage paper anchors and search links.
  const legacyPaper = [{% for key in site.data.publication_previews %}{{ key[0] | jsonify }},{% endfor %}"liu2026ocean"];
  if (legacyPaper.includes(location.hash.slice(1)) || new URLSearchParams(location.search).has("q")) {
    location.replace({{ '/publications/' | relative_url | jsonify }} + location.search + location.hash);
  }
</script>
